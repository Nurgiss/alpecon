// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// News model with multi-language support
model News {
  id        String   @id @default(uuid())

  // Multi-language fields for title
  title     String   // Default/fallback title
  titleRu   String?  @map("title_ru")
  titleKz   String?  @map("title_kz")
  titleEn   String?  @map("title_en")

  // Multi-language fields for content
  content   String   // Default/fallback content
  contentRu String?  @map("content_ru")
  contentKz String?  @map("content_kz")
  contentEn String?  @map("content_en")

  // Multi-language fields for category
  category   String  // Default/fallback category
  categoryRu String? @map("category_ru")
  categoryKz String? @map("category_kz")
  categoryEn String? @map("category_en")

  // Other fields
  image     String   // URL to image
  author    String
  source    String?  // Optional source/reference
  date      DateTime

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news")
}

// Editable page content (CMS overrides per page)
model PageContent {
  id        String   @id @default(uuid())
  pageKey   String   @unique @map("page_key")
  contentRu String   @default("{}") @map("content_ru")
  contentKz String   @default("{}") @map("content_kz")
  contentEn String   @default("{}") @map("content_en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("page_content")
}

// Structured content blocks (directions, team, projects)
model ContentBlock {
  id        String   @id @default(uuid())
  type      String
  sortOrder Int      @default(0) @map("sort_order")
  image     String   @default("")
  active    Boolean  @default(true)
  fieldsRu  String   @default("{}") @map("fields_ru")
  fieldsKz  String   @default("{}") @map("fields_kz")
  fieldsEn  String   @default("{}") @map("fields_en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, sortOrder])
  @@map("content_blocks")
}
