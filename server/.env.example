# Backend Environment Variables

# Database URL
# Development: file:./dev.db
# Production: file:./production.db or postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Server Configuration
NODE_ENV=development
PORT=3002

# JWT Configuration (generate a secure random string for production)
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=24h

# Admin Credentials (CHANGE THESE IN PRODUCTION!)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Telegram Bot — для получения заявок с формы вакансий
TELEGRAM_BOT_TOKEN=8727768134:AAHopsjq772hU6LsGdgyZf_91nRypzRegd0
TELEGRAM_CHAT_ID=your-chat-id-here
